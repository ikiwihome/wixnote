{
  "name": "wixnote",
  "version": "1.1.0",
  "private": true,
  "packageManager": "pnpm@12.3.4",
  "type": "module",
  "engines": {
    "node": ">=24.22.1"
  },
  "scripts": {
    "test": "node --test tests/*.test.js",
    "test:e2e": "playwright test",
    "lint": "npm run lint:js && npm run lint:css && npm run format:check",
    "lint:js": "eslint . --max-warnings 0",
    "lint:css": "stylelint \"src/**/*.css\" \"public/editor/*.css\" --max-warnings 0",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "dev": "node scripts/dev.js",
    "dev:server": "node --watch server/index.js",
    "dev:client": "vite --host 127.0.0.1",
    "build": "vite build",
    "start": "node server/index.js"
  },
  "dependencies": {
    "adm-zip": "^0.6.1",
    "dompurify": "^3.2.0",
    "entities": "^8.1.0",
    "express": "^5.1.0",
    "html-docx-js-typescript": "^0.1.5",
    "lucide-react": "^0.468.0",
    "marked": "^17.0.0",
    "multer": "^2.0.2",
    "playwright-core": "^1.64.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sanitize-html": "^2.17.0",
    "turndown": "^7.2.0",
    "wiz-editor": "0.0.767"
  },
  "devDependencies": {
    "@babel/parser": "^7.29.11",
    "@eslint-react/eslint-plugin": "^5.28.8",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.56.0",
    "@vitejs/plugin-react": "^5.0.0",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^16.5.0",
    "prettier": "^3.9.10",
    "stylelint": "^16.26.1",
    "stylelint-config-recommended": "^16.0.0",
    "vite": "^7.0.0"
  }
}
